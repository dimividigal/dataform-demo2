config {
  type: "operations"
}

-- Step 1: Drop tables if they exist
DROP TABLE IF EXISTS `sql-big-query-510418.dataform.sales`;
DROP TABLE IF EXISTS `sql-big-query-510418.dataform.clean_sales`;
DROP TABLE IF EXISTS `sql-big-query-510418.dataform.sales_summary`;

-- Step 2: Create ales table and load from CSV
CREATE TABLE `sql-big-query-510418.dataform.sales` (
  order_id STRING,
  product_name STRING,
  category STRING,
  quantity INT64,
  unit_price FLOAT64,
  order_date DATE
);

LOAD DATA INTO `sql-big-query-510418.dataform.sales`
FROM FILES (
  format = 'CSV',
  uris = ['gs://job-gcs-bq/dataform/sales.csv'],
  skip_leading_rows = 1
);

-- Step 3: Create clean_sales with calculated total_price
CREATE TABLE `sql-big-query-510418.dataform.clean_sales` AS
SELECT
  order_id,
  product_name,
  category,
  quantity,
  unit_price,
  quantity * unit_price AS total_price,
  order_date
FROM
  `sql-big-query-510418.dataform.sales`
WHERE
  quantity > 0 AND unit_price > 0;

-- Step 4: Create sales_summary aggregated by category
CREATE TABLE `sql-big-query-510418.dataform.sales_summary` AS
SELECT
  category,
  SUM(quantity) AS total_quantity,
  SUM(total_price) AS total_revenue
FROM
  `sql-big-query-510418.dataform.clean_sales`
GROUP BY
  category;

CREATE TABLE `sql-big-query-510418.dataform.sales_top` AS
SELECT 
  product_name,
  count(order_id) as contagem_de_vendas
FROM `sql-big-query-510418.dataform.clean_sales`
GROUP BY product_name
ORDER BY COUNT(order_id) DESC
LIMIT 10